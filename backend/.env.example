PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/brainly
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Leave SMTP_* blank in development — reset links are logged to the server
# console instead of emailed when SMTP isn't configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Brainly <no-reply@brainly.app>
